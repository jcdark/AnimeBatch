<Page
    x:Class="AnimeBatch.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Página inteira com rolagem: com a janela pequena, nada fica escondido -->
    <ScrollViewer Padding="24,24,24,24">
        <StackPanel Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock x:Name="TitleText" Text="Configurações" FontSize="24" FontWeight="SemiBold" />

            <InfoBar x:Name="FatalInfo" IsOpen="False" IsClosable="False" Severity="Error"
                     Title="Falha na inicialização" />

            <TextBlock x:Name="IntegrationsHeader" Text="Integrações" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                <PasswordBox x:Name="TmdbKeyBox" Header="Chave da API do TMDB (v3)" MinWidth="420"
                             PasswordRevealMode="Peek"
                             PlaceholderText="cole aqui a chave de themoviedb.org" />
                <Button x:Name="BtnSaveTmdbKey" Content="Salvar chave" Click="BtnSaveTmdbKey_Click"
                        VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="TmdbKeyHint" Text="Crie uma conta gratuita em themoviedb.org → Configurações → API para obter a chave."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="TmdbKeyStatus" Foreground="Gray" FontSize="12" />
            <TextBlock x:Name="LanguageHeader" Text="Idioma do sistema" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="CmbLanguage" MinWidth="280" SelectionChanged="CmbLanguage_SelectionChanged" />
            <TextBlock x:Name="LanguageHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="SourceDirHeader" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBox x:Name="SourceDirBox" MinWidth="560" />
                <Button x:Name="BtnBrowseSourceDir" Click="BtnBrowseSourceDir_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="SourceDirHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="OutputDirHeader" Text="Pasta de destino das conversões" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBox x:Name="OutDirBox" MinWidth="560" />
                <Button x:Name="BtnBrowseOutDir" Click="BtnBrowseOutDir_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="OutputDirHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="UpscaleGpusHeader" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="UpscaleGpusBox" MinWidth="280" MaxWidth="720" HorizontalAlignment="Left" />
            <TextBlock x:Name="UpscaleGpusHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <!-- Calibragem Automática: bitrate (kbps) por nível de criticidade -->
            <TextBlock x:Name="CalibrationHeader" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock x:Name="CalibrationExplanation" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                       MaxWidth="720" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumberBox x:Name="NumCalVeryLow" MinWidth="140" SpinButtonPlacementMode="Compact" SmallChange="50" Minimum="0" />
                <NumberBox x:Name="NumCalLow" MinWidth="140" SpinButtonPlacementMode="Compact" SmallChange="50" Minimum="0" />
                <NumberBox x:Name="NumCalNormal" MinWidth="140" SpinButtonPlacementMode="Compact" SmallChange="50" Minimum="0" />
                <NumberBox x:Name="NumCalHigh" MinWidth="140" SpinButtonPlacementMode="Compact" SmallChange="50" Minimum="0" />
                <NumberBox x:Name="NumCalVeryHigh" MinWidth="140" SpinButtonPlacementMode="Compact" SmallChange="50" Minimum="0" />
                <Button x:Name="BtnSaveCalibration" Click="BtnSaveCalibration_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="CalibrationHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <!-- Base de dados local (AppData): arquivo, tamanho e limpeza -->
            <TextBlock x:Name="DatabaseHeader" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock x:Name="DbInfoText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BtnClearDb" Click="BtnClearDb_Click" />
            </StackPanel>
            <TextBlock x:Name="DbClearHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <!-- Créditos das ferramentas embarcadas (com rolagem própria da página) -->
            <TextBlock x:Name="ToolsHeader" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
            <StackPanel x:Name="ToolsPanel" Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</Page>
