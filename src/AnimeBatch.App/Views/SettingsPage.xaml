<Page
    x:Class="AnimeBatch.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="Configurações" FontSize="24" FontWeight="SemiBold" />

        <InfoBar Grid.Row="1" x:Name="FatalInfo" IsOpen="False" IsClosable="False" Severity="Error"
                 Title="Falha na inicialização" />

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="ToolsHeader" Text="Ferramentas embutidas (pasta tools\ do app)" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="DbPathLabel" Foreground="Gray" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="IntegrationsHeader" Text="Integrações" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                <PasswordBox x:Name="TmdbKeyBox" Header="Chave da API do TMDB (v3)" MinWidth="420"
                             PasswordRevealMode="Peek"
                             PlaceholderText="cole aqui a chave de themoviedb.org" />
                <Button x:Name="BtnSaveTmdbKey" Content="Salvar chave" Click="BtnSaveTmdbKey_Click"
                        VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="TmdbKeyHint" Text="Crie uma conta gratuita em themoviedb.org → Configurações → API para obter a chave."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="TmdbKeyStatus" Foreground="Gray" FontSize="12" />
            <TextBlock x:Name="LanguageHeader" Text="Idioma do sistema" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="CmbLanguage" MinWidth="280" SelectionChanged="CmbLanguage_SelectionChanged" />
            <TextBlock x:Name="LanguageHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="SourceDirHeader" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBox x:Name="SourceDirBox" MinWidth="560" />
                <Button x:Name="BtnBrowseSourceDir" Click="BtnBrowseSourceDir_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="SourceDirHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="OutputDirHeader" Text="Pasta de destino das conversões" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
                <TextBox x:Name="OutDirBox" MinWidth="560" />
                <Button x:Name="BtnBrowseOutDir" Click="BtnBrowseOutDir_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="OutputDirHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="UpscaleGpusHeader" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="UpscaleGpusBox" MinWidth="280" MaxWidth="720" HorizontalAlignment="Left" />
            <TextBlock x:Name="UpscaleGpusHint" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="ToolsPanel" Spacing="6" />
        </ScrollViewer>
    </Grid>
</Page>
