<Page
    x:Class="AnimeBatch.App.Views.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AnimeBatch.App.Views">

    <Page.Resources>
        <!-- Resultado da busca TMDB: miniatura 3 por linha + nome (ano) -->
        <DataTemplate x:Key="TmdbResultTemplate" x:DataType="vm:TmdbResultRow">
            <StackPanel Width="150" Margin="4" HorizontalAlignment="Left">
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="4" Height="210" Width="140">
                    <Image Source="{x:Bind Thumb}" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{x:Bind Label}" FontSize="12" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" Margin="2,6,0,0" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="Séries" FontSize="24" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="SeriesCombo" MinWidth="340" SelectionChanged="SeriesCombo_SelectionChanged" />
            <Button x:Name="BtnNew" Content="Novo" Click="BtnNew_Click" />
            <Button x:Name="BtnSave" Content="Salvar" Click="BtnSave_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="BtnDelete" Content="Excluir" Click="BtnDelete_Click" />
            <Button x:Name="BtnTmdb" Content="Buscar no TMDB" Click="BtnTmdb_Click" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: poster + sinopse -->
            <StackPanel Grid.Column="0" Spacing="10">
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="6" Width="258" Height="387"
                        HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock x:Name="NoImageLabel" Text="Sem imagem"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" />
                        <Image x:Name="PosterImage" Stretch="Uniform" />
                    </Grid>
                </Border>
                <TextBlock x:Name="OverviewText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Coluna direita: presets + histórico -->
            <StackPanel Grid.Column="1" Spacing="12">
                <StackPanel Spacing="10">
                    <TextBox x:Name="EditorName" Header="Nome da série" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="EditorEpisode" Header="Episódio (kbps)"
                                   SpinButtonPlacementMode="Compact" SmallChange="50" MinWidth="180" />
                        <NumberBox x:Name="EditorOpening" Header="Abertura (kbps)"
                                   SpinButtonPlacementMode="Compact" SmallChange="50" MinWidth="180" />
                        <NumberBox x:Name="EditorEnding" Header="Encerramento (kbps)"
                                   SpinButtonPlacementMode="Compact" SmallChange="50" MinWidth="180" />
                    </StackPanel>
                    <TextBlock x:Name="EditorStatus" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="Arquivos Convertidos" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"
                           x:Name="HistoryTitle" />
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        CornerRadius="4" Padding="8">
                    <StackPanel>
                        <Grid Padding="4,2" ColumnSpacing="10" Opacity="0.6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="ColDate" Text="Data" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" x:Name="ColFile" Text="Arquivo" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" x:Name="ColDuration" Text="Duração" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" x:Name="ColSize" Text="Tamanho" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="300" Margin="0,2,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConversionRowViewModel">
                                    <Grid Padding="4,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Data}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Duracao}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Tamanho}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="HistoryEmpty" Text="Nenhuma conversão ainda — o histórico é preenchido quando a fila processar episódios desta série."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="4,6,0,2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
