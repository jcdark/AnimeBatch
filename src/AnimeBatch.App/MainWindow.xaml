<Window
    x:Class="AnimeBatch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AnimeBatch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView Grid.Row="0" x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="230"
                        SelectionChanged="Nav_SelectionChanged"
                        PaneOpened="Nav_PaneOpened"
                        PaneClosed="Nav_PaneClosed">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavQueue" Tag="queue" Icon="List" />
                <NavigationViewItem x:Name="NavEpisodes" Tag="episodes" Icon="Video" />
                <NavigationViewItem x:Name="NavEncodes" Tag="encodes" Icon="Folder" />
                <NavigationViewItem x:Name="NavHardware" Tag="hardware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE772;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSeries" Tag="series" Icon="Library" />
                <NavigationViewItem x:Name="NavSettings" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <!-- O hamburger de fábrica deu lugar ao logo do AB: clicar alterna o painel.
                 Com o painel aberto o nome aparece por inteiro; fechado, só o logo. -->
            <NavigationView.PaneHeader>
                <Button x:Name="PaneToggle" Click="PaneToggle_Click"
                        Background="Transparent" BorderThickness="0" Padding="12,8,12,8"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="AnimeBatch">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="LogoImage" Width="28" Height="28" />
                        <TextBlock x:Name="PaneTitle" Text="AnimeBatch" FontWeight="SemiBold" FontSize="16"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneHeader>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Rodapé: estatísticas vivas durante a conversão -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="16,6">
            <TextBlock x:Name="FooterText" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
